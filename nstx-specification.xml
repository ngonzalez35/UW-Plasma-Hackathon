<?xml version="1.0" encoding="UTF-8"?>
<diagnostics>
  <diagnostic name="mpts" tree="activespec" path="\top.mpts.output_data.best">
    <axis name="radius" node="fit_radii" units="cm" />
    <axis name="time" node="ts_times" units="s" />
    <signal name="te" node="fit_te" units="keV" title="Electron Temperature" axes="radius,time" error="fit_te_err" />
    <signal name="ne" node="fit_ne" units="cm^-3" title="Electron Density" axes="radius,time" error="fit_ne_err" />
    <signal name="ld" node="ts_ld" units="cm^-2" title="Line Density" axes="time" />
  </diagnostic>
  <diagnostic name="chers" tree="activespec" path="\chers_best">
    <axis name="radius" node="radius" units="cm" />
    <axis name="time" node="time" units="s" />
    <signal name="ti" node="ti" units="keV" title="Ion Temperature" axes="time,radius" error="dti" />
    <signal name="vt" node="vt" units="km/s" title="Toroidal Velocity" axes="time,radius" error='dvt' />
    <signal name="ft" node="ft" units="kHz" title="Toroidal Frequency" axes="time,radius" error='dft' />
    <signal name="nc" node="nc" units="1e13/cm^3" title="Carbon Density" axes="time,radius" error='dnc' />
    <signal name="valid" node="valid" units="" title="Valid flag" axes="time,radius" />
  </diagnostic>
  <diagnostic name="interferometer" tree="microwave">
    <axis name="time" node="dim_of(\TOP.FIRETIP.ANALYSIS:DENSITYC1)" units="s" />
    <signal name="ch{channel:02d}" node="\TOP.FIRETIP.ANALYSIS:DENSITYC{channel:d}" units="1/cm^3" title="Line Density Chord {channel:d}" axes="time" range="1,7" />
  </diagnostic>
  <diagnostic name="magnetics" tree="ops_pc">
    <axis name="time_highf" node="dim_of(\bdot_l1dmivvhf1_raw)" units="s" />
    <signal name="highf" node="\bdot_l1dmivvhf1_raw" units="V" title="High Frequency Bdot" axes="time_highf" />
    <axis name="time_highn" node="dim_of(\bdot_l1dmivvhn1_raw)" units="s" />
    <signal name="highn_ch{channel:02d}" node="\bdot_l1dmivvhn{channel:02d}_raw" units="V" title="High N Bdot Channel {channel:d}" axes="time_highn" range="1,16" />
  </diagnostic>
  <diagnostic name="usxr" tree="usxr">
    <axis name="time_vtop" node="dim_of(\usxr_vtop_00.raw)" units="s" />
    <axis name="time_hup" node="dim_of(\usxr_hup_00.raw)" units="s" />
    <axis name="time_hdown" node="dim_of(\usxr_hdown_00.raw)" units="s" />
    <signal name="vtop_ch{channel:02d}" node="\usxr_vtop_{channel:02d}.raw" units="DN" title="USXR Vertical Top Channel {channel:d}" axes="time_vtop" range="0,15" />
    <signal name="hup_ch{channel:02d}" node="\usxr_hup_{channel:02d}.raw" units="DN" title="USXR Horizontal Up Channel {channel:d}" axes="time_hup" range="0,15" />
    <signal name="hdown_ch{channel:02d}" node="\usxr_hdown_{channel:02d}.raw" units="DN" title="USXR Horizontal Down Channel {channel:d}" axes="time_hdown" range="0,15" />
  </diagnostic>
  <diagnostic name="bes" tree="activesp_raw">
    <axis name="time" node="dim_of(\TOP.BES.RAWDATA:BE_DT32_01:INPUT_01)" units="s" />
    <signal name="ch{channel:02d}" node="\TOP.BES.RAWDATA:BE_DT32_01:INPUT_{channel:02d}" units="V" title="BES Channel {channel:d}" axes="time" range="1,64" />
  </diagnostic>
  <diagnostic name="bolometer" tree="passivespec">
    <axis name="time" node="dim_of(\bolom_totpwr)" units="s" />
    <signal name="radpower" node="\bolom_totpwr" units="MW" title="Total Radiated Power" axes="time" />
  </diagnostic>
  <diagnostic name="filterscopes" tree="passivespec">
    <axis name="time1" node="dim_of(\bayg_dalpha_eies)" units="s" />
    <axis name="time2" node="dim_of(\bayi_opipe_dalpha)" units="s" />
    <axis name="time3" node="dim_of(\baye_dalf_haifa)" units="s" />
    <axis name="time4" node="dim_of(\bayd_dalpha_haifa)" units="s" />
    <axis name="time5" node="dim_of(\bayi_dalpha_eies)" units="s" />
    <axis name="time6" node="dim_of(\bayc_opipe_dalpha)" units="s" />
    <axis name="time7" node="dim_of(\da_ld)" units="s" />
    <axis name="time8" node="dim_of(\da_mp)" units="s" />
    <axis name="time9" node="dim_of(\da_mptg)" units="s" />
    <axis name="time10" node="dim_of(\da_ud)" units="s" />
    <signal name="bayg_dalpha_eies" node="\bayg_dalpha_eies" units="AU" title="Dalpha Midplane Tangential" axes="time1" />
    <signal name="bayi_opipe_dalpha" node="\bayi_opipe_dalpha" units="AU" title="Dalpha Inner Divertor" axes="time2" />
    <signal name="baye_dalf_haifa" node="\baye_dalf_haifa" units="AU" title="Dalpha Upper Divertor" axes="time3" />
    <signal name="bayd_dalpha_haifa" node="\bayd_dalpha_haifa" units="AU" title="Dalpha Lower Divertor" axes="time4" />
    <signal name="bayi_dalpha_eies" node="\bayi_dalpha_eies" units="AU" title="Dalpha Midplane Radial" axes="time5" />
    <signal name="bayc_opipe_dalpha" node="\bayc_opipe_dalpha" units="AU" title="Dalpha Inner Divertor Bay C" axes="time6" />
    <signal name="dalpha_lowerdiv" node="\da_ld" units="AU" title="Dalpha Lower Divertor Bay D" axes="time7" />
    <signal name="dalpha_mprad" node="\da_mp" units="AU" title="Dalpha Midplane Radial Bay B" axes="time8" />
    <signal name="dalpha_mptan" node="\da_mptg" units="AU" title="Dalpha Midplane Tangential Bay G" axes="time9" />
    <signal name="dalpha_upperdiv" node="\da_ud" units="AU" title="Dalpha Upper Divertor Bay E" axes="time10" />
  </diagnostic>
</diagnostics>
